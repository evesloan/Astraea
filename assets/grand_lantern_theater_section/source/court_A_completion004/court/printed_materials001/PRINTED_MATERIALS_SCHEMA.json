{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "pieces",
    "stacks",
    "display_plate",
    "materials",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pieces": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "name",
          "vertices_world",
          "faces",
          "face_uv",
          "face_material_roles",
          "closed_solid",
          "bounds_world"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "vertices_world": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "faces": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            }
          },
          "face_uv": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "face_material_roles": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "enum": [
                "court_A_matte_paper",
                "court_A_cover_stock",
                "court_A_printed_paper",
                "court_A_original_programme"
              ]
            }
          },
          "closed_solid": {
            "const": true
          },
          "bounds_world": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "display_plate": {
      "type": "object",
      "required": [
        "name",
        "vertices_world",
        "faces",
        "face_uv",
        "face_material_roles",
        "closed_solid",
        "bounds_world"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "vertices_world": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "faces": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          }
        },
        "face_uv": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "face_material_roles": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "enum": [
              "court_A_matte_paper",
              "court_A_cover_stock",
              "court_A_printed_paper",
              "court_A_original_programme"
            ]
          }
        },
        "closed_solid": {
          "const": true
        },
        "bounds_world": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "stacks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "materials": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": {
        "const": false
      }
    }
  }
}
