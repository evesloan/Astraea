    },
    {
      "catalogue_id": "AST-SAL-005",
      "readout": "Three substantial supported posts carry a continuous tactile cap with restrained inset/arris, real empty receiver fields and visible fixing feet. It is a restrained terminal component. Its usefulness and avoidance of a detached decorative rail depend on the separately reviewed physical portal join in the combined arrangement. No glass/infill or completed safety barrier supplied.",
      "component_pass": true,
      "assembly_gate_separate": true
    },
    {
      "catalogue_id": "AST-SAL-006",
      "readout": "Guest-facing ivory frame, three vertical teal recessed fields and timber ledge distinguish this from the open shelf/service side. The real corner work surface and low return provide a coherent useful transition. The normal-height rear view retains some Eevee shadow grain, but shelf positions, open mouths and bearing sides remain readable. All shelves/returns are fixed.",
      "pass": true
    }
