  "findings": [
    {
      "catalogue_id": "AST-SAL-001",
      "readout": "Deep rounded ivory return creates a legible compressed threshold, with tactile walnut inner jamb/soffit, framed blue-green recess and limited thin metal arris. Editable empty aperture is clear. Footing/material faces now terminate deliberately and the earlier native ivory speckling is gone.",
      "pass": true
    },
    {
      "catalogue_id": "AST-SAL-002",
      "readout": "Rising front profile makes the change from low sheltered edge to raised quiet header readable. Actual low bearing, high end face and rear shell join are numerically verified. It is a joined overhead section with no independent roof/floating canopy claim. Actual sloped fixture receiving normals and separate aiming directions are retained.",
      "pass": true
    },
    {
      "catalogue_id": "AST-SAL-003",
      "readout": "Continuous backed shell, curved vertical ribs, joined cove, tactile side/book returns and shaped upholstered seat group form a useful sheltered quiet edge. At640\u00d7360 the stepped front profile, distinct seat pads, accessible side storage and material/contact hierarchy remain legible without emission or CRT. Final front inset and book/arm boundaries have deliberate physical separation, resolving exposed coplanarity.",
      "pass": true
    }
  ],
  "limits": [
    "The open roof reservation requires SAL002; no complete room or disconnected ornamental roof is accepted.",
    "Opaque fixture lenses and optional receiver datums do not implement electrical operation or runtime illumination.",
    "Three visible seat pads do not assign species, registered capacity or universal reach/fit.",
    "The later7.2\u00d75.4\u00d73.8m quiet-bay maximum is an authoring bound; missing final host polygon and real moving-door interfaces remain unresolved.",
    "This neutral Blender inspection is not the original game renderer, performance testing or restored host."
  ]
