func validate_core_cap() -> void:
	var core := ship.get_node_or_null("ShipSpace/Districts/PrimaryAtriumCore_WIP/PrimaryCoreEnclosure") as Node3D
	if not check(core != null, "Existing primary core enclosure missing"):
		return
	var visual := PackedVector3Array()
	var contacts := PackedVector3Array()
	for node in core.find_children("*","MeshInstance3D",true,false):
		var mesh := node as MeshInstance3D
		var faces := PackedVector3Array()
		for point in mesh.mesh.get_faces():
			faces.append(mesh.global_transform*point)
		append_cap_faces(faces,visual)
	for node in core.find_children("*","CollisionShape3D",true,false):
		var shape := node as CollisionShape3D
		if shape.shape is ConcavePolygonShape3D and not shape.disabled:
			var faces := PackedVector3Array()
			for point in shape.shape.get_faces():
				faces.append(shape.global_transform*point)
			append_cap_faces(faces,contacts)
	var signature := "ec5e8f322a381b9a626395fe5dd8820e4f8ed3396d885a57bab50a7712cc14a7"
	check(visual.size() == 120 and geometry_signature(visual) == signature and geometry_signature(contacts) == signature, "Original primary-core 109.73..109.85 cap-band render/contact geometry changed")
	for point in [Vector2.ZERO,Vector2(-1.5,-1.5),Vector2(-1.5,1.5),Vector2(1.5,-1.5),Vector2(1.5,1.5)]:
		var hit := ray(Vector3(point.x,110.0,-106+point.y),Vector3(point.x,109.7,-106+point.y),own_exclusions)
		check(not hit.is_empty() and core.is_ancestor_of(hit.collider) and absf(hit.position.y-109.85) < EPS, "Actual primary-core cover top must remain 109.85")
	assert_empty(AABB(Vector3(-7.9,106.52,-113),Vector3(15.8,3.331,33)),shell_only_exclusions,"Primary-core cover/occupied volume")
	assert_empty(AABB(Vector3(-2,109.855,-108.2),Vector3(4,1.144,4.4)),shell_only_exclusions,"Clear roof separation above primary-core cap")

func append_cap_faces(faces: PackedVector3Array, output: PackedVector3Array) -> void:
	for index in range(0,faces.size(),3):
		var keep := true
		for offset in range(3):
			keep = keep and faces[index+offset].y >= 109.729 and faces[index+offset].y <= 109.851
		if keep:
			output.append_array(PackedVector3Array([faces[index],faces[index+1],faces[index+2]]))

func _same_rectangle(boundary: Array, x0: float, x1: float, z0: float, z1: float) -> bool:
	if boundary.size() != 4:
		return false
	var expected := {Vector2(x0, z0): true, Vector2(x1, z0): true, Vector2(x1, z1): true, Vector2(x0, z1): true}
	for point in boundary:
		expected.erase(Vector2(float(point[0]), float(point[1])))
	return expected.is_empty()

func validate_core_openings() -> void:
	var opening_count := 0
	var exclusions: Array[RID] = []
	for body in ship.find_children("*", "CollisionObject3D", true, false):
		if not floors.is_ancestor_of(body) and not platform.is_ancestor_of(body):
			exclusions.append(body.get_rid())
	var layout := read_json("res://data/spatial_layout.json")
	if layout.is_empty():
		return
	var expected := {
		"primary_atrium_core": [-106.0, -90.65, 18], "forward_public_core": [-438.0, -422.65, 17],
		"fore_midship_public_core": [-278.0, -262.65, 17], "aft_midship_public_core": [266.0, 281.35, 17],
		"aft_public_core": [426.0, 441.35, 17], "aft_crown_link": [113.0, 128.35, 2]}
	for prefix in expected:
		for kind in ["lift", "stairs"]:
			var id: String = str(prefix) + "_" + str(kind)
			var matches: Array = layout.voids.filter(func(item: Dictionary) -> bool: return str(item.id) == id)
			if not check(matches.size() == 1, "Protected core opening absent/duplicated: " + id):
				continue
			var opening: Dictionary = matches[0]
			var centre_z := float(expected[prefix][0 if kind == "lift" else 1])
			var half := Vector2(1.82, 2.02) if kind == "lift" else Vector2(3.1, 5.35)
			var count := int(expected[prefix][2]) - (1 if kind == "stairs" else 0)
			check(opening.decks.size() == count, "Protected core opening deck count changed: " + id)
			check(_same_rectangle(opening.boundary, -half.x, half.x, centre_z - half.y, centre_z + half.y), "Protected core opening bounds changed: " + id)
			for deck in opening.decks:
				var index := int(str(deck).substr(1)) - 1
				var y := float(ship.deck_y[index])
				var bounds := AABB(Vector3(-half.x + 0.02, y - 0.6, centre_z - half.y + 0.02), Vector3(half.x * 2.0 - 0.04, 0.7, half.y * 2.0 - 0.04))
				for hit in box_hits(bounds, exclusions, id + "/" + str(deck)):
					check(false, "Protected core/deck opening filled: " + id + "/" + str(deck) + " -> " + owner(hit))
				opening_count += 1
	check(opening_count == 170, "All 170 protected core/deck openings must execute")


func validate_fixtures(data: Dictionary) -> void:
	var markers: Array = data.get("light_markers",[])
	check(markers.size() == 20 and shell.find_children("DATUM_light_*","Node3D",true,false).size() == 20 and platform.find_children("BridgePlatformSource_*","SpotLight3D",true,false).size() == 20, "Exactly 20 real fixture markers and runtime source lights required")
	var unique: Dictionary = {}
	for item in markers:
		var name := str(item.name)
		check(not unique.has(name), "Duplicate fixture marker")
		unique[name] = true
		var marker := shell.find_child(name,true,false) as Node3D
		var light := platform.find_child("BridgePlatformSource_"+name,true,false) as SpotLight3D
		if not check(marker != null and light != null, "Missing actual source marker/light: " + name):
			continue
		var point := v3(item.position)
		check(marker.global_position.distance_to(point) < EPS and light.global_position.distance_to(point) < EPS and (-light.global_basis.z).dot(Vector3.DOWN) > 0.999, "Fixture placement/aim differs from source: " + name)
		for offset in [Vector3.ZERO,Vector3(-0.05,0,0),Vector3(0.05,0,0),Vector3(0,0,-0.05),Vector3(0,0,0.05)]:
			var start: Vector3 = point+offset
			var exit_hit := ray(start,start+Vector3.DOWN*0.25,dynamic_exclusions)
			var lens := ray(start,start+Vector3.UP*0.08,dynamic_exclusions)
			check(exit_hit.is_empty(), "Real fixture exit obstructed: " + name + " -> " + owner(exit_hit))
			check(not lens.is_empty() and shell.is_ancestor_of(lens.collider), "Fixture has no actual emitting lens above source: " + name)
		var reviewed: Array = source_audit.get("fixture_checks",[]).filter(func(row:Dictionary)->bool:return str(row.marker) == name)
		check(reviewed.size() == 1 and bool(reviewed[0].get("pass",false)) and not reviewed[0].get("housing_positive_seats",[]).is_empty(), "Fixture missing from immutable positive-seat source proof: " + name)

func run() -> void:
	var data := read_json(CONTRACT)
	if data.is_empty():
		quit(1)
		return
	validate_provenance(data)
	var scene := load("res://scenes/main.tscn") as PackedScene
	if not check(scene != null,"Main scene absent"):
		quit(1)
		return
	var main := scene.instantiate()
	root.add_child(main)
	for frame in range(30):
		await physics_frame
	ship = main.get_node_or_null("World360/Astraea") as Node3D
	if not check(ship != null,"Actual main-scene ship absent"):
		quit(1)
		return
	platform = ship.get_node_or_null("ShipSpace/Districts/BridgePlatform_WIP") as Node3D
	if not check(platform != null,"Bridge-platform adoption absent"):
		quit(1)
		return
	shell = platform.get_node_or_null("BridgePlatformArchitecture") as Node3D
	floors = ship.find_child("CompiledStructuralFloors_NotFinishedRooms",true,false) as Node3D
	if not check(shell != null and floors != null,"Required actual architecture/floor roots absent"):
		quit(1)
		return
	check(shell.global_transform.is_equal_approx(Transform3D.IDENTITY),"Reviewed kit must be placed at the original world origin")
	space = ship.get_world_3d().direct_space_state
	for body in ship.find_children("*","CollisionObject3D",true,false):
		var permanent: bool = body is StaticBody3D and not body is AnimatableBody3D
		if not permanent:
			dynamic_exclusions.append(body.get_rid())
		if platform.is_ancestor_of(body) or not permanent:
			own_exclusions.append(body.get_rid())
		if not shell.is_ancestor_of(body):
			shell_only_exclusions.append(body.get_rid())
		if not floors.is_ancestor_of(body):
			slab_only_exclusions.append(body.get_rid())
		if not floors.is_ancestor_of(body) or region_id(body) in FLOOR_IDS:
			old_floor_exclusions.append(body.get_rid())
	validate_meshes()
	validate_interfaces()
	validate_piers(data)
	validate_floors()
	validate_spine_interfaces()
	validate_clearances()
	validate_core_cap()
	validate_core_openings()
	validate_fixtures(data)
	if not failures.is_empty():
		print("BRIDGE PLATFORM STRUCTURE: %d recorded failures" % failures.size())
		quit(1)
		return
	print("BRIDGE PLATFORM STRUCTURE PASS: immutable 785-batch/40,728-triangle render/contact identity; oriented positive support-chain interfaces; 4 physical piers, 64 slices/20 keel rays; 4,480m2 single-owned floors and real bearing witnesses; exact spine seams, slab-height east closure, D17 headroom, open mouths/6m bypass, primary cap/170 openings, supported guard returns and 20 fixtures with 100 clear exits. Architectural contacts only; no structural load certification.")
	main.queue_free()
	await process_frame
	quit()
