func _initialize() -> void:
	call_deferred("run")

func check(condition: bool, detail: String) -> bool:
	if not condition:
		failures.append(detail)
		push_error("BRIDGE PLATFORM STRUCTURE FAIL: " + detail)
	return condition

func read_json(path: String) -> Dictionary:
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not check(parsed is Dictionary, "Missing/invalid JSON: " + path):
		return {}
	return parsed

func v3(values: Array) -> Vector3:
	return Vector3(float(values[0]), float(values[1]), float(values[2]))

func vertex_key(point: Vector3) -> String:
	return "%d,%d,%d" % [roundi(point.x * 1000), roundi(point.y * 1000), roundi(point.z * 1000)]

func geometry_signature(faces: PackedVector3Array) -> String:
	var triangles := PackedStringArray()
	for index in range(0, faces.size(), 3):
		var corners := PackedStringArray()
		for offset in range(3):
			corners.append(vertex_key(faces[index + offset]))
		corners.sort()
		triangles.append("|".join(corners))
	triangles.sort()
	return "\n".join(triangles).sha256_text()

func ray(start: Vector3, finish: Vector3, excluded: Array[RID]) -> Dictionary:
	var query := PhysicsRayQueryParameters3D.create(start, finish)
	query.exclude = excluded
	return space.intersect_ray(query)

func box_hits(bounds: AABB, excluded: Array[RID], label: String) -> Array[Dictionary]:
	var shape := BoxShape3D.new()
	shape.size = bounds.size
	var query := PhysicsShapeQueryParameters3D.new()
	query.shape = shape
	query.margin = 0.0005
	query.transform.origin = bounds.get_center()
	query.exclude = excluded
	var hits := space.intersect_shape(query, MAX_RESULTS)
	check(hits.size() < MAX_RESULTS, "Query capacity saturated: " + label)
	return hits

func owner(hit: Dictionary) -> String:
	return "<no contact>" if hit.is_empty() else str(hit.collider.get_path())

func region_id(body: Node) -> String:
	var node := body
	while node != null:
		if node.has_meta("region_id"):
			return str(node.get_meta("region_id"))
		node = node.get_parent()
	return ""

func assert_empty(bounds: AABB, exclusions: Array[RID], label: String) -> void:
	for hit in box_hits(bounds, exclusions, label):
		check(false, label + " -> " + owner(hit))

func validate_provenance(data: Dictionary) -> void:
	check(FileAccess.get_sha256(ASSET) == SOURCE_EXPORT_SHA256 and str(data.get("export_sha256", "")) == SOURCE_EXPORT_SHA256, "Final reviewed GLB bytes changed")
	check(FileAccess.get_sha256(CONTACT_AUDIT) == CONTACT_AUDIT_SHA256, "Independent oriented source contact review changed")
	check(FileAccess.get_sha256(ROUNDTRIP) == ROUNDTRIP_SHA256, "Exact source/export proof changed")
	source_audit = read_json(CONTACT_AUDIT)
	var roundtrip := read_json(ROUNDTRIP)
	check(str(source_audit.get("source_sha256", "")) == SOURCE_BLEND_SHA256 and str(roundtrip.get("source_sha256", "")) == SOURCE_BLEND_SHA256 and str(roundtrip.get("export_sha256", "")) == SOURCE_EXPORT_SHA256, "Contact graph and exact roundtrip must refer to the same frozen source/export")
	check(bool(roundtrip.get("exact_float32_position_oriented_triangle_uv_material_equality", false)), "Exact source/export geometry proof absent")
	check(int(source_audit.get("structural_mesh_count", 0)) == 2833 and int(source_audit.get("actual_contact_edges", 0)) == 21583, "Independent contact graph census changed")
	for key in ["structural_disconnected", "all_mesh_disconnected", "ledger_mismatch", "unresolved_geometry_findings"]:
		check(source_audit.has(key) and source_audit[key].is_empty(), "Source review has unresolved geometry: " + key)
	check(data.get("doors", []).is_empty(), "Stage one must not adopt private bridge doors")

func validate_meshes() -> void:
	var minimum := Vector3(INF, INF, INF)
	var maximum := Vector3(-INF, -INF, -INF)
	var meshes := shell.find_children("*", "MeshInstance3D", true, false)
	check(meshes.size() == EXPECTED_BATCHES, "Expected exactly 785 imported bounded batches; no extra floor meshes")
	for node in meshes:
		var mesh := node as MeshInstance3D
		if not check(mesh.mesh != null and mesh.is_visible_in_tree(), "Missing/hidden mesh: " + str(mesh.name)):
			continue
		var local_faces := mesh.mesh.get_faces()
		check(local_faces.size() > 0 and local_faces.size() % 3 == 0, "Invalid batch triangles: " + str(mesh.name))
		for vertex in local_faces:
			var point: Vector3 = mesh.global_transform * vertex
			minimum = minimum.min(point)
			maximum = maximum.max(point)
			all_faces.append(point)
		var contact := mesh.get_node_or_null("StaticContact/SharedShape") as CollisionShape3D
		if check(contact != null and not contact.disabled, "Missing real static contact: " + str(mesh.name)):
			check(contact.shape is ConcavePolygonShape3D and contact.get_parent() is StaticBody3D and contact.get_parent().collision_layer != 0, "Inactive/non-triangle contact: " + str(mesh.name))
			if contact.shape is ConcavePolygonShape3D:
				check(contact.shape.get_faces() == local_faces and contact.global_transform.is_equal_approx(mesh.global_transform), "Actual render/contact geometry differs: " + str(mesh.name))
	check(all_faces.size() == EXPECTED_TRIANGLES * 3, "Expected all 40,728 source triangles")
	var actual_signature := geometry_signature(all_faces)
	check(actual_signature == IMPORTED_TRIANGLE_SHA256, "Imported world triangles differ from immutable source/export proof; refresh imports or independently measure correspondence before changing pins: " + actual_signature)
	check(minimum.distance_to(Vector3(-48, -3.2, -181)) < EPS and maximum.distance_to(Vector3(35.94, 114.32, -80)) < EPS, "Actual source bounds changed")
	for index in range(0, all_faces.size(), 3):
		for offset in range(3):
			var key := vertex_key(all_faces[index + offset])
			if not vertex_triangles.has(key):
				vertex_triangles[key] = []
			vertex_triangles[key].append(index)

func complete_face(masks: Dictionary, ids: Array) -> bool:
	# Cyclic four-corner order: only complementary diagonal halves cover a face.
	var a := 1 << int(ids[0])
	var b := 1 << int(ids[1])
	var c := 1 << int(ids[2])
	var d := 1 << int(ids[3])
	return (masks.has(a | b | c) and masks.has(a | c | d)) or (masks.has(a | b | d) and masks.has(b | c | d))

func actual_prism(row: Array) -> PackedVector3Array:
	var expected := PackedVector3Array()
	var actual := PackedVector3Array()
	var candidates: Dictionary = {}
	for point in row[3]:
		var vertex := v3(point)
		expected.append(vertex)
		actual.append(Vector3(INF, INF, INF))
		# Sub-mm importer displacement can cross a rounding-bin boundary. Bins
		# accelerate lookup only; actual corner distance decides correspondence.
		var cell := Vector3i(roundi(vertex.x*1000),roundi(vertex.y*1000),roundi(vertex.z*1000))
		for dx in [-1,0,1]:
			for dy in [-1,0,1]:
				for dz in [-1,0,1]:
					var key := "%d,%d,%d" % [cell.x+dx,cell.y+dy,cell.z+dz]
					for index in vertex_triangles.get(key, []):
						candidates[index] = true
	var masks: Dictionary = {}
	var maximum_error := 0.0
	for index in candidates:
		var ids: Array[int] = []
		for offset in range(3):
			var vertex: Vector3 = all_faces[index+offset]
			var nearest := -1
			var distance := EPS
			for corner in range(expected.size()):
				var error := vertex.distance_to(expected[corner])
				if error < distance:
					distance = error
					nearest = corner
			if nearest >= 0:
				ids.append(nearest)
		if ids.size() != 3:
			continue
		var mask := 0
		for offset in range(3):
			var id := ids[offset]
			var vertex: Vector3 = all_faces[index + offset]
			maximum_error = maxf(maximum_error, vertex.distance_to(expected[id]))
			actual[id] = vertex
			mask |= 1 << id
		masks[mask] = true
	var complete := true
	for face in PRISM_FACES:
		complete = complete and complete_face(masks, face)
	var valid := check(complete and maximum_error < EPS, "Actual oriented member lacks complete complementary six-face coverage/eight precise corners: %s (max matched corner error %.6fm)" % [str(row[0]),maximum_error])
	return actual if valid else PackedVector3Array()

func polygon_area(points: PackedVector2Array) -> float:
	var area := 0.0
	for index in range(points.size()):
		area += points[index].cross(points[(index + 1) % points.size()])
	return absf(area) * 0.5

func footprint(vertices: PackedVector3Array) -> PackedVector2Array:
	var points := PackedVector2Array()
	for index in range(4):
		points.append(Vector2(vertices[index].x, vertices[index].z))
	return points

func part_bounds(vertices: PackedVector3Array) -> AABB:
	var bounds := AABB(vertices[0], Vector3.ZERO)
	for point in vertices:
		bounds = bounds.expand(point)
	return bounds

func validate_interfaces() -> void:
	check(complete_face({7:true,13:true}, [0,1,2,3]) and not complete_face({7:true,11:true}, [0,1,2,3]) and not complete_face({7:true}, [0,1,2,3]), "Complementary face coverage must reject holes/overlapping half faces")
	var definitions: Array = JSON.parse_string(INTERFACE_PARTS_JSON)
	check(definitions.size() == EXPECTED_INTERFACE_PARTS, "Frozen interface inventory changed")
	for row in definitions:
		var vertices := actual_prism(row)
		if not vertices.is_empty():
			actual_parts[str(row[0])] = {"vertices":vertices, "assembly":str(row[1]), "group":str(row[2])}
	var pairs: Array = JSON.parse_string(INTERFACE_PAIRS_JSON)
	check(pairs.size() == EXPECTED_INTERFACE_PAIRS, "Frozen contact witness count changed")
	for pair in pairs:
		if not check(actual_parts.has(pair[0]) and actual_parts.has(pair[1]), "Both actual interface pieces required: " + str(pair[2])):
			continue
		check(source_audit.get("assembly_contacts", {}).has(pair[2]), "Interface absent from independent source contact graph: " + str(pair[2]))
		var a: PackedVector3Array = actual_parts[pair[0]].vertices
		var b: PackedVector3Array = actual_parts[pair[1]].vertices
		var intersections := Geometry2D.intersect_polygons(footprint(a), footprint(b))
		var area := 0.0
		for polygon in intersections:
			area += polygon_area(polygon)
		var ba := part_bounds(a)
		var bb := part_bounds(b)
		var depth := minf(ba.end.y, bb.end.y) - maxf(ba.position.y, bb.position.y)
		check(area > 0.00001 and depth > EPS, "Actual oriented interface needs positive volume, not an AABB-only/marker contact: " + str(pair[2]))

func validate_piers(data: Dictionary) -> void:
	var expected := [Vector2(-29,-168), Vector2(29,-168), Vector2(-35.5,-86), Vector2(35.5,-86)]
	check(data.support.pier_centres_xz.size() == 4, "Exactly four approved piers required")
	for index in range(4):
		var centre: Vector2 = expected[index]
		var declared: Array = data.support.pier_centres_xz[index]
		check(Vector2(float(declared[0]), float(declared[1])).distance_to(centre) < EPS, "Pier audit coordinates changed")
		for datum in [["base",-3.2],["head",114.0]]:
			var name := "DATUM_bridge_pier_%02d_%s" % [index + 1, datum[0]]
			var marker := shell.find_child(name, true, false) as Node3D
			check(marker != null and marker.global_position.distance_to(Vector3(centre.x,float(datum[1]),centre.y)) < EPS, "Actual pier marker changed: " + name)
		for segment in range(16):
			var low := lerpf(-3.19, 114.0, segment / 16.0)
			var high := lerpf(-3.19, 114.0, (segment + 1) / 16.0)
			var label := "pier %d slice %d" % [index + 1, segment]
			var bounds := AABB(Vector3(centre.x - 0.4, low, centre.y - 0.6), Vector3(0.8, high-low,1.2))
			for hit in box_hits(bounds, own_exclusions, label):
				# Fore piers intentionally pierce ONLY their new parent-owned wing slab.
				var allowed: bool = index < 2 and region_id(hit.collider) == FLOOR_IDS[index] and low < FLOOR_Y and high > SLAB_BOTTOM
				check(allowed, "Pier contacts unintended permanent architecture: " + label + " -> " + owner(hit))
			var y := (low + high) * 0.5
			var witness := ray(Vector3(centre.x-1,y,centre.y+0.17), Vector3(centre.x+1,y,centre.y+0.17), shell_only_exclusions)
			check(not witness.is_empty() and shell.is_ancestor_of(witness.collider) and absf(witness.position.x-(centre.x-0.4)) < EPS, "No actual full-height pier chord at " + label)
			pier_slices += 1
		for offset in [Vector2.ZERO,Vector2(-0.4,-0.6),Vector2(-0.4,0.6),Vector2(0.4,-0.6),Vector2(0.4,0.6)]:
			var start := Vector3(centre.x+offset.x,-3.0,centre.y+offset.y)
			var hit := ray(start, start-Vector3.UP*0.4, own_exclusions)
			check(not hit.is_empty() and "HUL_KeelPan" in owner(hit) and absf(hit.position.y+3.2) < EPS, "Pier centre/corner lacks real keel support: " + str(start))
			keel_rays += 1
		var base := ray(Vector3(centre.x,-3.25,centre.y+0.17), Vector3(centre.x,-3.1,centre.y+0.17), shell_only_exclusions)
		check(not base.is_empty() and absf(base.position.y+3.2) < EPS, "Built pier base must meet keel without a gap")
		if index < 2:
			slab_witness(centre, FLOOR_IDS[index], "Intended fore pier/wing slab interface")
	check(keel_rays == 20 and pier_slices == 64, "All four physical pier envelope/support sets must execute")

func slab_witness(point: Vector2, expected_id: String, label: String) -> void:
	var top := ray(Vector3(point.x,106.6,point.y), Vector3(point.x,106.4,point.y), slab_only_exclusions)
	var bottom := ray(Vector3(point.x,106.1,point.y), Vector3(point.x,106.4,point.y), slab_only_exclusions)
	check(not top.is_empty() and region_id(top.collider) == expected_id and absf(top.position.y-FLOOR_Y) < EPS, label + ": wrong/missing real slab top -> " + owner(top))
	check(not bottom.is_empty() and region_id(bottom.collider) == expected_id and absf(bottom.position.y-SLAB_BOTTOM) < EPS, label + ": wrong/missing real slab underside -> " + owner(bottom))

func compiled_faces(region: Dictionary) -> PackedVector3Array:
	var faces := PackedVector3Array()
	var top := float(region.floor_y)
	var bottom := top-float(region.thickness)
	for triangle in region.triangles:
		for y in [top,bottom]:
			for point in triangle:
				faces.append(Vector3(float(point[0]),y,float(point[1])))
	for ring in region.rings:
		for index in range(ring.size()):
			var p: Array = ring[index]
			var q: Array = ring[(index+1)%ring.size()]
			var a := Vector3(float(p[0]),top,float(p[1]))
			var b := Vector3(float(q[0]),top,float(q[1]))
			var c := Vector3(float(q[0]),bottom,float(q[1]))
			var d := Vector3(float(p[0]),bottom,float(p[1]))
			faces.append_array(PackedVector3Array([a,b,c,a,c,d]))
	return faces

func slab_triangle_ownership(triangle: Array, y: float, expected_id: String) -> void:
	# Exterior-centred shallow prisms avoid backface-culled concave slab interiors.
	var centre := Vector2.ZERO
	for point in triangle:
		centre += Vector2(float(point[0]),float(point[1]))/3.0
	var vertices := PackedVector3Array()
	for point in triangle:
		var p := Vector2(float(point[0]),float(point[1])).move_toward(centre,0.002)
		vertices.append(Vector3(p.x,y-0.01,p.y))
		vertices.append(Vector3(p.x,y+0.01,p.y))
	var shape := ConvexPolygonShape3D.new()
	shape.points = vertices
	shape.margin = 0.0001
	var query := PhysicsShapeQueryParameters3D.new()
	query.shape = shape
	query.margin = 0.0001
	query.exclude = own_exclusions
	var hits := space.intersect_shape(query,MAX_RESULTS)
	check(hits.size() > 0 and hits.size() < MAX_RESULTS, "Slab ownership prism empty/saturated: " + expected_id)
	for hit in hits:
		check(region_id(hit.collider) == expected_id, "Duplicate/unintended physical floor ownership: " + expected_id + " -> " + owner(hit))

func expected_floor(point: Vector2) -> String:
	if point.x >= -4.0 and point.x <= 4.0 and point.y >= -181 and point.y <= -113:
		return "D18_fore_route"
	if point.y >= -172 and point.y <= -118 and absf(point.x) < 36:
		return FLOOR_IDS[0 if point.x < 0 else 1]
	return FLOOR_IDS[2]

func validate_floors() -> void:
	var layout := read_json("res://data/spatial_layout.json")
	var generated := read_json("res://data/generated/structural_meshes.json")
	var owned: Array = layout.regions.filter(func(row:Dictionary)->bool:return str(row.get("authoring_owner","")) == "bridge_platform")
	check(owned.size() == 3, "Exactly three new parent-owned regions required")
	for index in range(3):
		var id: String = FLOOR_IDS[index]
		var found: Array = generated.regions.filter(func(row:Dictionary)->bool:return str(row.id) == id)
		if not check(found.size() == 1, "Missing/duplicate compiled slab: " + id):
			continue
		var region: Dictionary = found[0]
		check(absf(float(region.floor_y)-FLOOR_Y) < EPS and absf(float(region.thickness)-0.24) < EPS and absf(float(region.structural_area_m2)-[1692.0,1692.0,1096.0][index]) < EPS, "Wrong platform slab area/datum/thickness: " + id)
		var slab := floors.get_node_or_null(id) as Node3D
		if not check(slab != null, "Real compiled floor absent: " + id):
			continue
		var contact_faces := PackedVector3Array()
		var render_faces := PackedVector3Array()
		for node in slab.find_children("*","CollisionShape3D",true,false):
			var shape := node as CollisionShape3D
			if check(not shape.disabled and shape.shape is ConcavePolygonShape3D, "Slab must retain active concave contacts: " + id):
				for point in shape.shape.get_faces():
					contact_faces.append(shape.global_transform*point)
		for node in slab.find_children("*","MeshInstance3D",true,false):
			var mesh := node as MeshInstance3D
			if check(mesh.mesh != null and mesh.is_visible_in_tree(), "Slab must be visible: " + id):
				for point in mesh.mesh.get_faces():
					render_faces.append(mesh.global_transform*point)
		var signature := geometry_signature(compiled_faces(region))
		check(geometry_signature(contact_faces) == signature and geometry_signature(render_faces) == signature, "Actual slab must exactly match compiled polygon, sides and thickness: " + id)
		for triangle in region.triangles:
			slab_triangle_ownership(triangle,FLOOR_Y+0.005,id)
			slab_triangle_ownership(triangle,SLAB_BOTTOM-0.005,id)
	for name in actual_parts:
		var part: Dictionary = actual_parts[name]
		if str(part.group) not in ["platform_support","platform_support_shallow"]:
			continue
		var bounds := part_bounds(part.vertices)
		if bounds.end.y < SLAB_BOTTOM+EPS:
			continue
		var centre := bounds.get_center()
		# Every selected support below a real slab needs positive overlap with it.
		var point := Vector2(centre.x,centre.z)
		if str(part.assembly) == "BRP_EastReturnSlabHeightClosure":
			point.x = 3.85
		if str(part.assembly) == "BRP_SpineShallowSaddle":
			point.x = clampf(point.x,-3.8,3.8)
		var intended := expected_floor(point)
		slab_witness(point,intended,"Bearing " + str(name))
		check(bounds.end.y > SLAB_BOTTOM+EPS and bounds.end.y < FLOOR_Y-EPS, "Floor support must positively enter slab while staying below walking surface: " + str(name))
		var contacts := box_hits(AABB(Vector3(point.x-0.025,SLAB_BOTTOM-0.015,point.y-0.025),Vector3(0.05,0.02,0.05)),slab_only_exclusions,str(name))
		check(contacts.size() == 1 and region_id(contacts[0].collider) == intended, "Support lacks positive intended parent-slab underside witness: " + str(name))
		bearing_witnesses += 1
	check(bearing_witnesses >= 50, "Floor chain needs its real distributed bearing witnesses")
	for z in [-181.0,-177.0,-173.0,-160.0,-118.0,-115.0]:
		slab_witness(Vector2(0,z),"D18_fore_route","Preserved original centreline and 40m2 vestibule")

func boundary_only(x0: float, x1: float, edge: float) -> bool:
	var overlap := minf(x1,4.0)-maxf(x0,-4.0)
	var end := x1 if edge < 0 else x0
	return overlap <= 0.00001 and absf(end-edge) < 0.00001

func validate_spine_interfaces() -> void:
	check(boundary_only(-4.6,-4,-4) and boundary_only(4,4.6,4), "Boundary predicate must accept exact zero-overlap seams")
	check(not boundary_only(-4.6,-3.99,-4) and not boundary_only(3.99,4.6,4) and not boundary_only(-4.6,-4.01,-4), "Boundary predicate must reject intrusion and gaps")
	for side in [-1.0,1.0]:
		var edge: float = side*4.0
		for z in [-171.9,-118.1]:
			var label := "guard return/old spine X%s Z%s" % [edge,z]
			var old_face := ray(Vector3(edge+side*0.2,106.35,z),Vector3(edge-side*0.2,106.35,z),old_floor_exclusions)
			var new_face := ray(Vector3(edge-side*0.2,106.35,z),Vector3(edge+side*0.2,106.35,z),shell_only_exclusions)
			check(not old_face.is_empty() and region_id(old_face.collider) == "D18_fore_route" and absf(old_face.position.x-edge) < EPS, "Original slab needs exact lateral boundary at " + label)
			check(not new_face.is_empty() and absf(new_face.position.x-edge) < EPS, "Built return shoe needs boundary-only contact at " + label)
			if not old_face.is_empty() and not new_face.is_empty():
				check(absf(new_face.position.x-old_face.position.x) < EPS, "Actual spine interface has an intrusion/gap: " + label)
			var backing := ray(Vector3(edge+side*0.08,107.1,z-0.3),Vector3(edge+side*0.08,107.1,z+0.3),shell_only_exclusions)
			check(not backing.is_empty(), "Terminal guard return has no real backing: " + label)
			var expected_id: String = FLOOR_IDS[0 if side < 0 else 1]
			slab_witness(Vector2(edge+side*0.1,z),expected_id,"Guard return slab support")
	for row in JSON.parse_string(INTERFACE_PARTS_JSON):
		if "GuardMouthReturnShoe" in str(row[0]):
			var first := v3(row[3][0])
			var third := v3(row[3][2])
			check(boundary_only(minf(first.x,third.x),maxf(first.x,third.x),-4 if first.x < 0 else 4), "Frozen guard shoe is not an exact boundary-only seam")
	# East closure is a deliberately narrow slab-height interface, not a second
	# walking slab. Its precise geometry and roof-hanger contacts were reconstructed.
	for z in [-179.0,-174.5]:
		var top := ray(Vector3(3.85,106.505,z),Vector3(3.85,106.48,z),shell_only_exclusions)
		var bottom := ray(Vector3(3.85,106.255,z),Vector3(3.85,106.28,z),shell_only_exclusions)
		check(not top.is_empty() and absf(top.position.y-106.49) < EPS and not bottom.is_empty() and absf(bottom.position.y-106.265) < EPS, "Precise east-return below-walking-plane closure absent")
		slab_witness(Vector2(3.85,z),"D18_fore_route","East return positive existing-slab bearing")
		assert_empty(AABB(Vector3(3.75,106.495,z-0.1),Vector3(0.24,0.1,0.2)),shell_only_exclusions,"East closure must not duplicate the original walking plane")
	# New wing slabs share the existing spine's exact lateral plane, without
	# claiming a positive overlap. Rays independently isolate each physical owner.
	for side in [-1.0,1.0]:
		var edge: float = side*4.0
		var expected: String = FLOOR_IDS[0 if side < 0 else 1]
		var only_new: Array[RID] = slab_only_exclusions.duplicate()
		for body in floors.find_children("*","CollisionObject3D",true,false):
			if region_id(body) != expected:
				only_new.append(body.get_rid())
		for z in [-165.0,-145.0,-125.0]:
			var old_face := ray(Vector3(edge+side*0.2,106.35,z),Vector3(edge-side*0.2,106.35,z),old_floor_exclusions)
			var new_face := ray(Vector3(edge-side*0.2,106.35,z),Vector3(edge+side*0.2,106.35,z),only_new)
			check(not old_face.is_empty() and not new_face.is_empty() and region_id(new_face.collider) == expected and absf(old_face.position.x-edge) < EPS and absf(new_face.position.x-edge) < EPS, "New wing/old spine must meet exactly at their boundary")

