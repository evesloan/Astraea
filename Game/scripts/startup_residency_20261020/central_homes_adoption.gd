extends RefCounted
static func build(ship:Node3D)->void:
	var routes:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://data/architecture/startup_residency_20261020/central_room_routes.json"))
	for row in routes.routes:
		assert(FileAccess.get_sha256(str(row.original))==str(row.original_sha256))
		assert(FileAccess.get_sha256(str(row.successor))==str(row.successor_sha256))
	assert(FileAccess.get_sha256("res://scripts/central_homes_adoption.gd")=="097cf294e66e0d44e38facab0a1f9c1c087518430c50be74812c539f61ff8d3b","Central Homes predecessor changed")
	assert(bool(ship.get_meta("central_residential_streets_installed",false)))
	for script in ["star_atlas_rooms","night_garden_rooms"]:
		var homes:Node3D=load("res://scripts/"+script+".gd").build(ship)
		homes.set_meta("default_scene_enabled",true)
		homes.set_meta("acceptance","integrated_construction_wip")
		homes.set_meta("receiving_structure_accepted",false)
		homes.set_meta("occupied_capacity_accepted",false)
		await ship._construction_step("central_homes/"+str(script))
	load("res://scripts/star_atlas_specialty_first.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_first")
	load("res://scripts/star_atlas_specialty_second.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_second")
	load("res://scripts/star_atlas_eight_habitats.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_eight_habitats")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_third.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_third")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_fourth.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_fourth")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_fifth.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_fifth")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_sixth.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_sixth")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_seventh.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_seventh")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_eighth.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_eighth")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_ninth.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_ninth")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_tenth.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_tenth")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_eleventh.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_eleventh")
	load("res://scripts/startup_residency_20261020/central_rooms/star_atlas_specialty_twelfth.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_specialty_twelfth")
	load("res://scripts/star_atlas_d17_receiving_first.gd").build(ship)
	await ship._construction_step("central_homes/star_atlas_d17_receiving_first")
