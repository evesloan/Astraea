  var shapes:=mesh.find_children("*","CollisionShape3D",true,false);assert(shapes.size()==1,"Exact upper collision count: "+str(row.source_name)+" "+str(shapes.size()));var shape:CollisionShape3D=shapes[0];assert(shape.shape is ConcavePolygonShape3D);assert(digest(shape.shape.get_faces().to_byte_array())==digest(mesh.mesh.get_faces().to_byte_array()));var replacement:MeshInstance3D=model.find_child(str(row.replacement_name).validate_node_name(),true,false);assert(replacement!=null,"Exact upper replacement node: "+str(row.replacement_name));var before:Mesh=mesh.mesh;var prior:Shape3D=shape.shape;var edited:Mesh=replacement.mesh.duplicate();assert(edited.get_surface_count()==before.get_surface_count())
  for i in range(edited.get_surface_count()):edited.surface_set_material(i,before.surface_get_material(i))
  mesh.mesh=edited;shape.shape=edited.create_trimesh_shape();shape.shape.margin=prior.margin;var source_key:=str(row.source_name).replace("-","_").replace(".","_");assert(source_key.is_valid_identifier());group.set_meta(source_key+"_retained_mesh",before);group.set_meta(source_key+"_retained_shape",prior);witnesses.append({"source_node":str(mesh.get_path()),"original_faces_sha256":digest(before.get_faces().to_byte_array()),"new_faces_sha256":digest(edited.get_faces().to_byte_array())});replacement.free()
